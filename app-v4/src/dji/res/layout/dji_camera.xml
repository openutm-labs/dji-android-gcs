<?xml version="1.0" encoding="utf-8"?>
<!--
  The aircraft camera area on the Fly screen (dji build only), built from DJI's UI Library v4.
  Layout, sizes and the panel ids follow DJI's own sample (Mobile-UXSDK-Android, activity_default_widgets.xml):
  the widgets find camera_setting_*_panel, pre_flight_check_list and CameraCapturePanel by these ids.
  Its MapWidget is left out: the app's map is the offline MapLibre one.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dji_camera_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <dji.ux.widget.FPVWidget
        android:id="@+id/fpv_widget"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        custom:sourceCameraNameVisibility="true" />

    <dji.ux.widget.FPVOverlayWidget
        android:id="@+id/fpv_overlay_widget"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <dji.ux.workflow.CompassCalibratingWorkFlow
        android:id="@+id/ux_compass_workflow"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- DJI's status bar (pre-flight status, mode, GNSS, vision, RC, video link, battery, connection) is in
         the Fly screen's own top bar instead: dji_status_leading.xml and dji_status_trailing.xml. -->

    <dji.ux.widget.RemainingFlightTimeWidget
        android:id="@+id/remaining_flight_time"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_alignParentTop="true" />

    <!-- Camera exposure readouts: ISO, shutter, aperture, EV, white balance, storage -->
    <LinearLayout
        android:id="@+id/camera"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/remaining_flight_time"
        android:layout_centerHorizontal="true"
        android:background="#66000000"
        android:orientation="horizontal">
        <dji.ux.widget.config.CameraConfigISOAndEIWidget android:layout_width="50dp" android:layout_height="25dp" />
        <dji.ux.widget.config.CameraConfigShutterWidget android:layout_width="50dp" android:layout_height="25dp" />
        <dji.ux.widget.config.CameraConfigApertureWidget android:layout_width="50dp" android:layout_height="25dp" />
        <dji.ux.widget.config.CameraConfigEVWidget android:layout_width="50dp" android:layout_height="25dp" />
        <dji.ux.widget.config.CameraConfigWBWidget android:layout_width="60dp" android:layout_height="25dp" />
        <dji.ux.widget.config.CameraConfigStorageWidget android:layout_width="108dp" android:layout_height="25dp" />
    </LinearLayout>

    <!-- Capture controls: photo/video, shutter, camera settings menus -->
    <dji.ux.widget.controls.CameraControlsWidget
        android:id="@+id/CameraCapturePanel"
        android:layout_width="50dp"
        android:layout_height="213dp"
        android:layout_alignParentEnd="true"
        android:layout_below="@id/camera" />

    <!-- No DashboardWidget: it collides with the map inset on narrow RC screens, and the Fly screen's
         telemetry strip already shows height, distance and speeds. -->

    <!-- DJI's own take-off and return-to-home (the aircraft's standard calls) -->
    <LinearLayout
        android:id="@+id/TakeOffReturnPanel"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="160dp"
        android:orientation="vertical">
        <dji.ux.widget.TakeOffWidget android:layout_width="40dp" android:layout_height="40dp" android:layout_marginBottom="12dp" />
        <dji.ux.widget.ReturnHomeWidget android:layout_width="40dp" android:layout_height="40dp" />
    </LinearLayout>

    <!-- Panels the widgets above open -->
    <dji.ux.panel.CameraSettingExposurePanel
        android:id="@+id/camera_setting_exposure_panel"
        android:layout_width="180dp"
        android:layout_height="263dp"
        android:layout_below="@id/camera"
        android:layout_toStartOf="@id/CameraCapturePanel"
        android:visibility="gone" />

    <dji.ux.panel.CameraSettingAdvancedPanel
        android:id="@+id/camera_setting_advanced_panel"
        android:layout_width="180dp"
        android:layout_height="263dp"
        android:layout_below="@id/camera"
        android:layout_toStartOf="@id/CameraCapturePanel"
        android:visibility="gone" />

    <dji.ux.panel.PreFlightCheckListPanel
        android:id="@+id/pre_flight_check_list"
        android:layout_width="400dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/remaining_flight_time"
        custom:excludeItem="ESCStatus"
        android:visibility="gone" />
</RelativeLayout>
